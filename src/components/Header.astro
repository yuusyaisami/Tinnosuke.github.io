---
import { siteConfig } from "../config";
import { withBase } from "../utils/url";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/#games", label: "Games" },
  { href: "/#other-projects", label: "Other Projects" },
];
---

<header class="sticky top-0 z-50 border-b border-gray-200/80 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
  <div class="mx-auto flex min-h-16 w-full max-w-6xl items-center justify-between gap-6 px-4 py-3 sm:px-6 lg:px-8">
    <a
      class="min-w-0 text-slate-900 dark:text-slate-50"
      href={withBase("/")}
      aria-label={siteConfig.name}
    >
      <span class="block truncate text-lg font-bold tracking-tight">
        {siteConfig.name}
      </span>
      <span class="hidden text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 sm:block dark:text-slate-400">
        {siteConfig.title}
      </span>
    </a>

    <nav aria-label="Main Navigation">
      <ul class="flex flex-wrap items-center justify-end gap-x-5 gap-y-2 text-sm font-medium">
        {navItems.map((item) => (
          <li>
            <a
              class="text-slate-600 transition-colors hover:text-slate-950 dark:text-slate-300 dark:hover:text-white"
              href={withBase(item.href)}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
