---
import { heroDecorSprites } from "../utils/heroDecor";
import { withBase } from "../utils/url";

const TARGET_ICON_HEIGHT = 44;

const spritePayload = heroDecorSprites.map((sprite) => {
  const scale = TARGET_ICON_HEIGHT / sprite.frameHeight;

  return {
    ...sprite,
    src: withBase(sprite.src),
    displayWidth: Math.round(sprite.frameWidth * scale),
    displayHeight: TARGET_ICON_HEIGHT,
  };
});
---

<span class="random-sprite-icon" data-random-sprite-icon data-sprites={JSON.stringify(spritePayload)} aria-hidden="true">
  <span class="random-sprite-icon__stage" data-random-sprite-icon-stage></span>
</span>

<script is:inline>
  const spriteIconNodes = document.querySelectorAll("[data-random-sprite-icon]");

  for (const spriteIcon of spriteIconNodes) {
    if (spriteIcon.dataset.ready === "true") {
      continue;
    }

    spriteIcon.dataset.ready = "true";

    const stage = spriteIcon.querySelector("[data-random-sprite-icon-stage]");

    if (!stage) {
      continue;
    }

    const payload = spriteIcon.dataset.sprites;

    if (!payload) {
      continue;
    }

    let sprites;

    try {
      sprites = JSON.parse(payload);
    } catch {
      continue;
    }

    if (!Array.isArray(sprites) || sprites.length === 0) {
      continue;
    }

    const pickedSprite = sprites[Math.floor(Math.random() * sprites.length)];
    const wrapper = document.createElement("span");
    wrapper.className = "random-sprite-icon__item";
    wrapper.style.setProperty("--sprite-width", `${pickedSprite.displayWidth}px`);
    wrapper.style.setProperty("--sprite-height", `${pickedSprite.displayHeight}px`);

    if (pickedSprite.kind === "sheet") {
      const sheet = document.createElement("span");
      sheet.className = "random-sprite-icon__sheet";
      sheet.style.width = `${pickedSprite.displayWidth}px`;
      sheet.style.height = `${pickedSprite.displayHeight}px`;
      sheet.style.backgroundImage = `url(${pickedSprite.src})`;
      sheet.style.backgroundRepeat = "no-repeat";
      sheet.style.backgroundSize = `${pickedSprite.displayWidth * pickedSprite.frameCount}px ${pickedSprite.displayHeight}px`;
      sheet.style.animation = `random-sprite-icon-sheet ${pickedSprite.frameDurationMs}ms steps(${pickedSprite.frameCount}) infinite`;
      wrapper.append(sheet);
    } else {
      const image = document.createElement("img");
      image.className = "random-sprite-icon__image";
      image.src = pickedSprite.src;
      image.alt = "";
      image.decoding = "async";
      image.loading = "eager";
      wrapper.append(image);
    }

    stage.replaceChildren(wrapper);
  }
</script>

<style>
  .random-sprite-icon {
    display: inline-flex;
    min-width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
  }

  .random-sprite-icon__stage,
  .random-sprite-icon__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .random-sprite-icon__item {
    filter: drop-shadow(0 6px 12px rgba(15, 23, 42, 0.22));
    image-rendering: pixelated;
    transform: translateY(1px);
  }

  .random-sprite-icon__image,
  .random-sprite-icon__sheet {
    display: block;
    width: var(--sprite-width);
    height: var(--sprite-height);
    image-rendering: pixelated;
    object-fit: contain;
  }

  .random-sprite-icon__sheet {
    background-position: left center;
  }

  @keyframes random-sprite-icon-sheet {
    from {
      background-position: 0 0;
    }

    to {
      background-position: 100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .random-sprite-icon__sheet {
      animation: none !important;
    }
  }
</style>