---
import { siteConfig } from "../config";
import { withBase } from "../utils/url";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/#games", label: "Games" },
  { href: "/#other-projects", label: "Other Projects" },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/72 backdrop-blur-xl dark:border-slate-800/80 dark:bg-slate-950/68">
  <div class="mx-auto flex min-h-16 w-full max-w-6xl items-center justify-between gap-6 px-4 py-3 sm:px-6 lg:px-8">
    <a
      class="group flex min-w-0 items-center gap-3 text-slate-900 dark:text-slate-50"
      href={withBase("/")}
      aria-label={siteConfig.name}
    >
      <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-slate-200/80 bg-white/80 text-sm font-bold uppercase tracking-[0.2em] text-slate-700 shadow-sm transition-transform duration-300 group-hover:-translate-y-0.5 dark:border-slate-800 dark:bg-slate-900/80 dark:text-slate-100">
        TS
      </span>
      <span class="min-w-0">
        <span class="block truncate text-lg font-bold tracking-tight">
          {siteConfig.name}
        </span>
        <span class="hidden text-[11px] font-semibold uppercase tracking-[0.3em] text-slate-500 sm:block dark:text-slate-400">
          {siteConfig.title}
        </span>
      </span>
    </a>

    <nav aria-label="Main Navigation" class="rounded-full border border-slate-200/80 bg-white/80 p-1 shadow-sm dark:border-slate-800 dark:bg-slate-900/72">
      <ul class="flex flex-wrap items-center justify-end gap-1 text-sm font-medium">
        {navItems.map((item) => (
          <li>
            <a
              class="inline-flex min-h-10 items-center rounded-full px-4 py-2 text-slate-600 transition-all duration-200 hover:bg-slate-100 hover:text-slate-950 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white"
              href={withBase(item.href)}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
