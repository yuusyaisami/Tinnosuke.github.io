---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const aboutParagraphs = siteConfig.aboutMe
  .split("。")
  .map((sentence) => sentence.trim())
  .filter(Boolean)
  .map((sentence) => `${sentence}。`);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={`${siteConfig.name} の About ページ`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>About | {siteConfig.name}</title>
  </head>
  <body>
    <Header />
    <main class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <a
        href="/"
        class="text-sm font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
      >
        ← Back to Home
      </a>

      <header class="mt-6 border-b border-slate-200 pb-8 dark:border-slate-800">
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[var(--accent-color)]" style={`--accent-color: ${siteConfig.accentColor}`}>
          About
        </p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
          {siteConfig.name} について
        </h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-300">
          {siteConfig.title}
        </p>
      </header>

      <section class="mt-8 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/70 sm:p-8">
        <div class="space-y-6 text-base leading-8 text-slate-600 dark:text-slate-300">
          {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <div class="mt-8 border-t border-slate-200 pt-8 dark:border-slate-800">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
            Skills
          </h2>
          <div class="mt-4 flex flex-wrap gap-3">
            {siteConfig.skills.map((skill) => (
              <span class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                {skill}
              </span>
            ))}
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>