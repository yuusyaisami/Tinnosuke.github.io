---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { render } from "astro:content";
import { siteConfig } from "../../config";
import {
  formatProductionPeriod,
  getAllProjects,
  getCompletionLabel,
  getProjectBackLink,
  getProjectById,
  getProjectCollectionLabel,
  getProjectSections,
} from "../../utils/portfolio";
import { withBase } from "../../utils/url";
import "../../styles/global.css";

export async function getStaticPaths() {
  const projects = await getAllProjects();

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { projectId: project.id },
  }));
}

const { projectId } = Astro.props as {
  projectId: string;
};

const project = await getProjectById(projectId);

if (!project) {
  throw new Error(`Project not found: ${projectId}`);
}

const collectionLabel = getProjectCollectionLabel(project.data.category);
const backLink = getProjectBackLink(project.data.category);
const productionPeriod = formatProductionPeriod(
  project.data.production.start,
  project.data.production.end,
);
const completionLabel = getCompletionLabel(project);
const sections = await getProjectSections(project.id);
const renderedSections = await Promise.all(
  sections.map(async (section) => {
    const rendered = await render(section);

    return {
      ...section,
      ...rendered,
      anchorId: `section-${section.data.key}`,
    };
  }),
);
const sectionLinks = renderedSections.map((section) => ({
  id: section.anchorId,
  title: section.data.title,
}));
const tableOfContents = renderedSections.flatMap((section) => [
  {
    id: section.anchorId,
    depth: 1,
    text: section.data.title,
  },
  ...section.headings
    .filter((heading) => heading.depth >= 2 && heading.depth <= 3)
    .map((heading) => ({
      id: heading.slug,
      depth: heading.depth,
      text: heading.text,
    })),
]);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={project.data.summary} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{project.data.name} | {siteConfig.name}</title>
  </head>
  <body>
    <Header />
    <main class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
      <a
        href={withBase(backLink)}
        class="text-sm font-medium text-slate-500 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
      >
        ← Back
      </a>

      <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start">
        <section class="min-w-0">
          <p class="text-sm font-semibold uppercase tracking-[0.28em]" style={`color: ${siteConfig.accentColor}`}>
            {collectionLabel}
          </p>
          <h1 class="mt-4 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
            {project.data.name}
          </h1>
          <p class="mt-4 max-w-3xl text-base leading-8 text-slate-600 dark:text-slate-300 sm:text-lg">
            {project.data.summary}
          </p>

          {(productionPeriod || completionLabel) && (
            <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
              {productionPeriod && (
                <span class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 dark:border-slate-700 dark:bg-slate-900">
                  {project.data.media.icon && (
                    <img
                      src={withBase(project.data.media.icon)}
                      alt={`${project.data.name} icon`}
                      class="h-6 w-6 rounded-md object-cover"
                    />
                  )}
                  <span>{productionPeriod}</span>
                </span>
              )}
              {completionLabel && (
                <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 dark:border-slate-700 dark:bg-slate-900">
                  {completionLabel}
                </span>
              )}
            </div>
          )}

          {sectionLinks.length > 0 && (
            <nav class="mt-6 flex flex-wrap gap-3" aria-label="Section navigation">
              {sectionLinks.map((section) => (
                <a
                  href={`#${section.id}`}
                  class="inline-flex min-h-10 items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-300 hover:text-slate-950 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:text-white"
                >
                  {section.title}
                </a>
              ))}
            </nav>
          )}

          {project.data.media.screenshot && (
            <div class="mt-6 overflow-hidden rounded-3xl border border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-900">
              <img
                src={withBase(project.data.media.screenshot)}
                alt={`${project.data.name} screenshot`}
                class="h-full w-full object-cover"
              />
            </div>
          )}

          <div class="mt-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/70 sm:p-8">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
              Summary
            </h2>
            <div class="mt-4 text-base leading-8 text-slate-600 dark:text-slate-300">
              <p>{project.data.summary}</p>
            </div>
          </div>

          <div class="mt-6 space-y-6">
            {renderedSections.map((section) => {
              const Content = section.Content;

              return (
                <article
                  id={section.anchorId}
                  class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/70 sm:p-8"
                >
                  <div class="flex flex-wrap items-start justify-between gap-4">
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">
                        Section
                      </p>
                      <h2 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
                        {section.data.title}
                      </h2>
                      {section.data.lede && (
                        <p class="mt-3 max-w-3xl text-base leading-8 text-slate-600 dark:text-slate-300">
                          {section.data.lede}
                        </p>
                      )}
                    </div>

                    <a
                      href={`#${section.anchorId}`}
                      class="section-anchor"
                      aria-label={`${section.data.title} section link`}
                    >
                      #
                    </a>
                  </div>

                  <div class="article-prose mt-8">
                    <Content />
                  </div>
                </article>
              );
            })}
          </div>
        </section>

        <aside class="article-sidebar rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/70">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
            Project Info
          </h2>

          {project.data.skills.length > 0 && (
            <div class="mt-6">
              <h3 class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">
                Skills
              </h3>
              <div class="mt-3 flex flex-wrap gap-2">
                {project.data.skills.map((skill) => (
                  <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          )}

          {tableOfContents.length > 0 && (
            <div class="mt-8 border-t border-slate-200 pt-6 dark:border-slate-800">
              <h3 class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">
                On this page
              </h3>
              <nav class="mt-4" aria-label="Table of contents">
                <ul class="space-y-2">
                  {tableOfContents.map((item) => (
                    <li>
                      <a
                        href={`#${item.id}`}
                        class="block text-sm leading-6 text-slate-600 transition-colors hover:text-slate-950 dark:text-slate-300 dark:hover:text-white"
                        style={`padding-left: ${(item.depth - 1) * 0.9}rem`}
                      >
                        {item.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          )}

          {(project.data.links.game || project.data.links.source) && (
            <div class="mt-8 space-y-3 border-t border-slate-200 pt-6 dark:border-slate-800">
              {project.data.links.game && (
                <a
                  href={project.data.links.game}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 w-full items-center justify-center rounded-full px-5 text-sm font-semibold text-white"
                  style={`background-color: ${siteConfig.accentColor}`}
                >
                  Open Game
                </a>
              )}
              {project.data.links.source && (
                <a
                  href={project.data.links.source}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 w-full items-center justify-center rounded-full border border-slate-300 bg-white px-5 text-sm font-semibold text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
                >
                  Source Code
                </a>
              )}
            </div>
          )}
        </aside>
      </div>
    </main>
    <Footer />
  </body>
</html>
