---
import { heroDecorSprites } from "../utils/heroDecor";
import { withBase } from "../utils/url";

const spritePayload = heroDecorSprites.map((sprite) => ({
  ...sprite,
  src: withBase(sprite.src),
}));
---

<div class="hero-decor" data-hero-decor data-sprites={JSON.stringify(spritePayload)} aria-hidden="true">
  <div class="hero-decor__halo hero-decor__halo--primary"></div>
  <div class="hero-decor__halo hero-decor__halo--secondary"></div>
  <div class="hero-decor__grid"></div>
  <div class="hero-decor__sprite-shell">
    <div class="hero-decor__sprite" data-hero-decor-sprite></div>
  </div>
  <div class="hero-decor__caption">
    <span class="hero-decor__caption-label">Random environ</span>
    <span class="hero-decor__caption-value">sprite</span>
  </div>
</div>

<script is:inline>
  const heroDecorNodes = document.querySelectorAll("[data-hero-decor]");

  for (const heroDecor of heroDecorNodes) {
    if (heroDecor.dataset.ready === "true") {
      continue;
    }

    heroDecor.dataset.ready = "true";

    const spriteHost = heroDecor.querySelector("[data-hero-decor-sprite]");
    const spriteLabel = heroDecor.querySelector(".hero-decor__caption-value");

    if (!spriteHost) {
      continue;
    }

    const payload = heroDecor.dataset.sprites;

    if (!payload) {
      continue;
    }

    let sprites;

    try {
      sprites = JSON.parse(payload);
    } catch {
      continue;
    }

    if (!Array.isArray(sprites) || sprites.length === 0) {
      continue;
    }

    const pickedSprite = sprites[Math.floor(Math.random() * sprites.length)];
    const wrapper = document.createElement("div");
    wrapper.className = "hero-decor__sprite-item";
    wrapper.style.setProperty("--decor-width", `${pickedSprite.displayWidth}px`);
    wrapper.style.setProperty("--decor-height", `${pickedSprite.displayHeight}px`);
    wrapper.style.setProperty("--decor-float-duration", `${pickedSprite.floatDurationMs}ms`);
    wrapper.style.setProperty("--decor-float-distance", `${pickedSprite.floatDistance}px`);

    if (pickedSprite.kind === "sheet") {
      const sheet = document.createElement("div");
      sheet.className = "hero-decor__sheet";
      sheet.style.width = `${pickedSprite.displayWidth}px`;
      sheet.style.height = `${pickedSprite.displayHeight}px`;
      sheet.style.backgroundImage = `url(${pickedSprite.src})`;
      sheet.style.backgroundRepeat = "no-repeat";
      sheet.style.backgroundSize = `${pickedSprite.displayWidth * pickedSprite.frameCount}px ${pickedSprite.displayHeight}px`;
      sheet.style.animation = `hero-decor-sheet ${pickedSprite.frameDurationMs}ms steps(${pickedSprite.frameCount}) infinite`;
      wrapper.append(sheet);
    } else {
      const image = document.createElement("img");
      image.className = "hero-decor__image";
      image.src = pickedSprite.src;
      image.alt = "";
      image.decoding = "async";
      image.loading = "eager";
      wrapper.append(image);
    }

    spriteHost.replaceChildren(wrapper);

    if (spriteLabel && pickedSprite.id) {
      spriteLabel.textContent = pickedSprite.id;
    }
  }
</script>

<style>
  .hero-decor {
    position: relative;
    display: grid;
    min-height: 22rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 2rem;
    background:
      radial-gradient(circle at 22% 18%, rgba(96, 165, 250, 0.16), transparent 30%),
      radial-gradient(circle at 80% 74%, rgba(45, 212, 191, 0.14), transparent 28%),
      linear-gradient(180deg, rgba(15, 23, 42, 0.92), rgba(8, 15, 29, 0.94));
    box-shadow: 0 24px 60px rgba(8, 15, 29, 0.28);
    isolation: isolate;
  }

  .hero-decor__halo {
    position: absolute;
    border-radius: 999px;
    filter: blur(10px);
    opacity: 0.75;
  }

  .hero-decor__halo--primary {
    inset: 2rem auto auto 1.5rem;
    width: 8rem;
    height: 8rem;
    background: rgba(59, 130, 246, 0.18);
  }

  .hero-decor__halo--secondary {
    inset: auto 1.25rem 1rem auto;
    width: 9rem;
    height: 9rem;
    background: rgba(45, 212, 191, 0.16);
  }

  .hero-decor__grid {
    position: absolute;
    inset: 1.25rem;
    border-radius: 1.4rem;
    border: 1px solid rgba(148, 163, 184, 0.12);
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.08) 1px, transparent 1px);
    background-size: 1.3rem 1.3rem;
    mask-image: radial-gradient(circle at center, black 55%, transparent 100%);
  }

  .hero-decor__sprite-shell {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 16rem;
    width: 100%;
    place-items: center;
    padding: 2rem;
  }

  .hero-decor__sprite {
    display: grid;
    place-items: center;
  }

  .hero-decor__sprite-item {
    display: grid;
    place-items: center;
    width: min(var(--decor-width), 100%);
    max-width: 100%;
    animation: hero-decor-float var(--decor-float-duration, 6000ms) ease-in-out infinite;
    filter: drop-shadow(0 14px 24px rgba(15, 23, 42, 0.34));
    image-rendering: pixelated;
    transform-origin: center;
  }

  .hero-decor__image,
  .hero-decor__sheet {
    width: min(var(--decor-width), 100%);
    height: var(--decor-height);
    max-width: 100%;
    object-fit: contain;
  }

  .hero-decor__image {
    display: block;
  }

  .hero-decor__sheet {
    background-position: left center;
    image-rendering: pixelated;
  }

  .hero-decor__caption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 1;
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    padding: 0.7rem 0.95rem;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.72);
    color: rgba(226, 232, 240, 0.9);
    backdrop-filter: blur(10px);
    font-size: 0.68rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .hero-decor__caption-label {
    color: rgba(148, 163, 184, 0.72);
  }

  @keyframes hero-decor-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }

    50% {
      transform: translate3d(0, calc(var(--decor-float-distance, 12px) * -1), 0) scale(1.02);
    }
  }

  @keyframes hero-decor-sheet {
    from {
      background-position: 0 0;
    }

    to {
      background-position: 100% 0;
    }
  }

  @media (max-width: 767px) {
    .hero-decor {
      min-height: 15rem;
    }

    .hero-decor__sprite-shell {
      min-height: 11rem;
      padding: 1.5rem;
    }

    .hero-decor__sprite-item {
      transform: scale(0.76);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-decor__sprite-item,
    .hero-decor__sheet {
      animation: none !important;
    }
  }
</style>
