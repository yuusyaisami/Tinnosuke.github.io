---
import { withBase } from "../utils/url";

type ShowcaseItem = {
  kind: "image" | "video";
  src: string;
  alt?: string;
  poster?: string;
  label?: string;
};

const { items, projectName } = Astro.props as {
  items: ShowcaseItem[];
  projectName: string;
};

const normalizedItems = items.map((item, index) => ({
  ...item,
  alt: item.alt ?? `${projectName} preview ${index + 1}`,
  label: item.label ?? `${item.kind === "video" ? "Video" : "Image"} ${index + 1}`,
  id: `showcase-item-${index + 1}`,
}));
---

{
  normalizedItems.length > 0 && (
    <section class="mt-6 space-y-3" data-project-showcase>
      <div class="group relative overflow-hidden rounded-3xl border border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-900">
        {normalizedItems.map((item, index) => (
          <figure
            class:list={["showcase-item", index === 0 && "is-active"]}
            data-showcase-item
            data-kind={item.kind}
            data-item-id={item.id}
            aria-hidden={index === 0 ? "false" : "true"}
          >
            {item.kind === "video" ? (
              <div class="showcase-video-shell">
                <video
                  src={withBase(item.src)}
                  poster={item.poster ? withBase(item.poster) : undefined}
                  class="showcase-video aspect-[16/9] w-full object-cover"
                  playsinline
                  preload="metadata"
                  aria-label={item.alt}
                  data-showcase-video
                  data-item-id={item.id}
                />

                <div class="showcase-video-overlay" data-video-overlay>
                  <button
                    type="button"
                    class="showcase-video-play"
                    data-video-play-toggle
                    aria-label="Toggle play"
                  >
                    <span class="showcase-video-play-icon" data-video-play-icon></span>
                  </button>

                  <div class="showcase-video-controls" data-video-controls>
                    <button
                      type="button"
                      class="showcase-video-control-button"
                      data-video-play-toggle
                      aria-label="Toggle play"
                    >
                      <span class="showcase-video-play-icon showcase-video-play-icon--small" data-video-play-icon></span>
                    </button>

                    <span class="showcase-video-time" data-video-current-time>0:00</span>
                    <input
                      type="range"
                      min="0"
                      max="1000"
                      value="0"
                      class="showcase-video-progress"
                      data-video-progress
                      aria-label="Video progress"
                    />
                    <span class="showcase-video-time" data-video-duration>0:00</span>
                    <button
                      type="button"
                      class="showcase-video-control-button showcase-video-control-button--muted"
                      data-video-mute-toggle
                      aria-label="Toggle mute"
                    >
                      <span data-video-mute-icon>Mute</span>
                    </button>
                  </div>
                </div>
              </div>
            ) : (
              <img
                src={withBase(item.src)}
                alt={item.alt}
                class="aspect-[16/9] w-full object-cover"
                loading={index === 0 ? "eager" : "lazy"}
              />
            )}

            <figcaption class="showcase-floating-label absolute left-4 top-4 inline-flex rounded-full border border-white/15 bg-slate-950/70 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.22em] text-white backdrop-blur">
              {item.label}
            </figcaption>
          </figure>
        ))}

        {normalizedItems.length > 1 && (
          <>
            <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-slate-950/25 to-transparent opacity-0 transition-opacity duration-300 group-[.is-ui-visible]:opacity-100" />
            <div class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-slate-950/25 to-transparent opacity-0 transition-opacity duration-300 group-[.is-ui-visible]:opacity-100" />

            <button
              type="button"
              data-showcase-prev
              class="showcase-floating-control absolute left-4 top-1/2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-slate-950/70 text-white opacity-0 shadow-lg backdrop-blur transition-all duration-300 hover:scale-[1.04] hover:bg-slate-950/85 group-[.is-ui-visible]:opacity-100"
              aria-label="Previous preview"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 18l-6-6l6-6" />
              </svg>
            </button>

            <button
              type="button"
              data-showcase-next
              class="showcase-floating-control absolute right-4 top-1/2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-slate-950/70 text-white opacity-0 shadow-lg backdrop-blur transition-all duration-300 hover:scale-[1.04] hover:bg-slate-950/85 group-[.is-ui-visible]:opacity-100"
              aria-label="Next preview"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 18l6-6l-6-6" />
              </svg>
            </button>

            <div class="showcase-floating-counter absolute bottom-4 right-4 rounded-full border border-white/15 bg-slate-950/70 px-3 py-1.5 text-xs font-semibold tracking-[0.2em] text-white backdrop-blur">
              <span data-showcase-counter>1 / {normalizedItems.length}</span>
            </div>
          </>
        )}
      </div>

      {normalizedItems.length > 1 && (
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {normalizedItems.map((item, index) => (
            <button
              type="button"
              class:list={["showcase-thumb", index === 0 && "is-active"]}
              data-showcase-thumb
              aria-pressed={index === 0 ? "true" : "false"}
              aria-label={`Show ${item.label}`}
            >
              <div class="showcase-thumb-frame relative overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 dark:border-slate-700 dark:bg-slate-900">
                {item.kind === "video" ? (
                  item.poster ? (
                    <img
                      src={withBase(item.poster)}
                      alt=""
                      class="aspect-[16/9] w-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <img
                      alt=""
                      class="aspect-[16/9] w-full object-cover"
                      loading="lazy"
                      data-showcase-thumb-poster
                      data-item-id={item.id}
                    />
                  )
                ) : (
                  <img
                    src={withBase(item.src)}
                    alt=""
                    class="aspect-[16/9] w-full object-cover"
                    loading="lazy"
                  />
                )}

                {item.kind === "video" && (
                  <span class="absolute bottom-2 right-2 inline-flex h-8 w-8 items-center justify-center rounded-full border border-white/20 bg-slate-950/75 text-white backdrop-blur">
                    <svg viewBox="0 0 24 24" class="h-4 w-4 translate-x-[1px]" fill="currentColor" aria-hidden="true">
                      <path d="M8 6.5v11l9-5.5z" />
                    </svg>
                  </span>
                )}
              </div>
            </button>
          ))}
        </div>
      )}
    </section>
  )
}

<script is:inline>
  const galleries = document.querySelectorAll("[data-project-showcase]");

  const formatTime = (value) => {
    if (!Number.isFinite(value)) {
      return "0:00";
    }

    const minutes = Math.floor(value / 60);
    const seconds = Math.floor(value % 60);

    return `${minutes}:${String(seconds).padStart(2, "0")}`;
  };

  const createPosterFromVideo = (videoSrc, callback) => {
    const probe = document.createElement("video");

    probe.preload = "auto";
    probe.muted = true;
    probe.playsInline = true;
    probe.crossOrigin = "anonymous";

    const captureFrame = () => {
      if (!probe.videoWidth || !probe.videoHeight) {
        callback(null);
        return;
      }

      const canvas = document.createElement("canvas");
      canvas.width = probe.videoWidth;
      canvas.height = probe.videoHeight;

      const context = canvas.getContext("2d");

      if (!context) {
        callback(null);
        return;
      }

      context.drawImage(probe, 0, 0, canvas.width, canvas.height);
      callback(canvas.toDataURL("image/png"));
    };

    probe.addEventListener("loadeddata", () => {
      if (probe.readyState >= 2) {
        if (probe.duration > 0.25) {
          const seekTarget = Math.min(0.25, Math.max(0.05, probe.duration / 5));
          probe.currentTime = seekTarget;
          return;
        }

        captureFrame();
      }
    }, { once: true });

    probe.addEventListener("seeked", captureFrame, { once: true });
    probe.addEventListener("error", () => callback(null), { once: true });
    probe.src = videoSrc;
  };

  for (const gallery of galleries) {
    if (gallery.dataset.ready === "true") {
      continue;
    }

    gallery.dataset.ready = "true";

    const items = Array.from(gallery.querySelectorAll("[data-showcase-item]"));
    const thumbs = Array.from(gallery.querySelectorAll("[data-showcase-thumb]"));
    const prevButton = gallery.querySelector("[data-showcase-prev]");
    const nextButton = gallery.querySelector("[data-showcase-next]");
    const counter = gallery.querySelector("[data-showcase-counter]");
    const videos = Array.from(gallery.querySelectorAll("[data-showcase-video]"));
    const thumbPosters = Array.from(gallery.querySelectorAll("[data-showcase-thumb-poster]"));

    let uiVisibleTimer;

    let activeIndex = Math.max(
      0,
      items.findIndex((item) => item.classList.contains("is-active")),
    );

    const showUi = (persist = false) => {
      gallery.classList.add("is-ui-visible");

      if (uiVisibleTimer) {
        window.clearTimeout(uiVisibleTimer);
      }

      if (!persist) {
        uiVisibleTimer = window.setTimeout(() => {
          gallery.classList.remove("is-ui-visible");
        }, 1600);
      }
    };

    const updateVideoState = (video) => {
      const item = video.closest("[data-showcase-item]");

      if (!item) {
        return;
      }

      item.classList.toggle("is-playing", !video.paused && !video.ended);

      const current = item.querySelector("[data-video-current-time]");
      const duration = item.querySelector("[data-video-duration]");
      const progress = item.querySelector("[data-video-progress]");
      const muteIcon = item.querySelector("[data-video-mute-icon]");

      if (current) {
        current.textContent = formatTime(video.currentTime);
      }

      if (duration) {
        duration.textContent = formatTime(video.duration);
      }

      if (progress) {
        progress.value = video.duration ? String((video.currentTime / video.duration) * 1000) : "0";
      }

      if (muteIcon) {
        muteIcon.textContent = video.muted ? "Unmute" : "Mute";
      }
    };

    const syncVideos = () => {
      items.forEach((item, index) => {
        const video = item.querySelector("video");

        if (!video) {
          return;
        }

        if (index !== activeIndex) {
          video.pause();
          video.currentTime = 0;
        }

        updateVideoState(video);
      });
    };

    const setActive = (nextIndex) => {
      activeIndex = (nextIndex + items.length) % items.length;

      items.forEach((item, index) => {
        const isActive = index === activeIndex;

        item.classList.toggle("is-active", isActive);
        item.setAttribute("aria-hidden", String(!isActive));
      });

      thumbs.forEach((thumb, index) => {
        const isActive = index === activeIndex;

        thumb.classList.toggle("is-active", isActive);
        thumb.setAttribute("aria-pressed", String(isActive));
      });

      if (counter) {
        counter.textContent = `${activeIndex + 1} / ${items.length}`;
      }

      syncVideos();
      showUi(true);
    };

    prevButton?.addEventListener("click", () => setActive(activeIndex - 1));
    nextButton?.addEventListener("click", () => setActive(activeIndex + 1));

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener("click", () => setActive(index));
    });

    gallery.addEventListener("mousemove", () => {
      const activeVideo = items[activeIndex]?.querySelector("video");
      showUi(!(activeVideo && !activeVideo.paused));
    });

    gallery.addEventListener("mouseleave", () => {
      if (uiVisibleTimer) {
        window.clearTimeout(uiVisibleTimer);
      }

      gallery.classList.remove("is-ui-visible");
    });

    gallery.addEventListener("focusin", () => showUi(true));

    videos.forEach((video) => {
      if (!video.poster) {
        createPosterFromVideo(video.currentSrc || video.src, (poster) => {
          if (!poster) {
            return;
          }

          video.poster = poster;

          const posterThumb = thumbPosters.find((thumb) => thumb.dataset.itemId === video.dataset.itemId);
          if (posterThumb) {
            posterThumb.src = poster;
          }
        });
      }

      video.controls = false;
      video.muted = true;

      video.addEventListener("timeupdate", () => updateVideoState(video));
      video.addEventListener("loadedmetadata", () => updateVideoState(video));
      video.addEventListener("play", () => {
        updateVideoState(video);
        showUi();
      });
      video.addEventListener("pause", () => {
        updateVideoState(video);
        showUi(true);
      });

      const item = video.closest("[data-showcase-item]");
      const playButtons = item ? Array.from(item.querySelectorAll("[data-video-play-toggle]")) : [];
      const muteButton = item?.querySelector("[data-video-mute-toggle]");
      const progress = item?.querySelector("[data-video-progress]");

      playButtons.forEach((button) => {
        button.addEventListener("click", () => {
          if (video.paused) {
            const playPromise = video.play();
            if (playPromise) {
              playPromise.catch(() => undefined);
            }
          } else {
            video.pause();
          }
        });
      });

      muteButton?.addEventListener("click", () => {
        video.muted = !video.muted;
        updateVideoState(video);
        showUi(true);
      });

      progress?.addEventListener("input", (event) => {
        if (!video.duration) {
          return;
        }

        const target = event.currentTarget;
        const nextValue = Number.parseFloat(target.value);

        if (Number.isFinite(nextValue)) {
          video.currentTime = (nextValue / 1000) * video.duration;
          updateVideoState(video);
        }
      });
    });

    setActive(activeIndex);
  }
</script>

<style>
  [data-project-showcase] {
    --showcase-ui-opacity: 0;
  }

  [data-project-showcase].is-ui-visible {
    --showcase-ui-opacity: 1;
  }

  .showcase-item {
    display: none;
    position: relative;
  }

  .showcase-item.is-active {
    display: block;
  }

  .showcase-video-shell {
    position: relative;
  }

  .showcase-video-overlay {
    pointer-events: none;
    position: absolute;
    inset: 0;
  }

  .showcase-video-play,
  .showcase-video-controls,
  .showcase-floating-label,
  .showcase-floating-control,
  .showcase-floating-counter {
    opacity: var(--showcase-ui-opacity);
    transition: opacity 180ms ease;
  }

  .showcase-video-play {
    pointer-events: auto;
    position: absolute;
    left: 50%;
    top: 50%;
    display: inline-flex;
    height: 4.5rem;
    width: 4.5rem;
    transform: translate(-50%, -50%);
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.72);
    color: white;
    backdrop-filter: blur(10px);
  }

  .showcase-item.is-playing .showcase-video-play {
    opacity: 0;
    pointer-events: none;
  }

  .showcase-video-controls {
    pointer-events: auto;
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 0.95rem;
    padding-right: 5.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 1.2rem;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.72), rgba(15, 23, 42, 0.88));
    color: white;
    backdrop-filter: blur(10px);
  }

  .showcase-video-control-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .showcase-video-control-button--muted {
    min-width: 3.9rem;
    justify-content: flex-end;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .showcase-video-play-icon {
    display: inline-block;
    width: 0;
    height: 0;
    border-top: 0.8rem solid transparent;
    border-bottom: 0.8rem solid transparent;
    border-left: 1.2rem solid currentColor;
    transform: translateX(2px);
  }

  .showcase-video-play-icon--small {
    border-top-width: 0.45rem;
    border-bottom-width: 0.45rem;
    border-left-width: 0.72rem;
  }

  .showcase-item.is-playing [data-video-play-icon] {
    width: 0.95rem;
    height: 1rem;
    border: 0;
    border-left: 0.32rem solid currentColor;
    border-right: 0.32rem solid currentColor;
    transform: none;
  }

  .showcase-video-progress {
    flex: 1;
    accent-color: rgb(37 99 235);
    cursor: pointer;
  }

  .showcase-video-time {
    min-width: 2.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .showcase-thumb {
    text-align: left;
  }

  .showcase-thumb.is-active .showcase-thumb-frame {
    border-color: rgb(37 99 235 / 0.85);
    box-shadow: 0 0 0 1px rgb(37 99 235 / 0.45);
  }

  .showcase-thumb:focus-visible {
    outline: none;
  }

  .showcase-thumb:focus-visible .showcase-thumb-frame {
    border-color: rgb(37 99 235 / 0.95);
    box-shadow: 0 0 0 2px rgb(37 99 235 / 0.35);
  }

  @media (max-width: 767px) {
    .showcase-video-controls {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      gap: 0.5rem;
      padding: 0.7rem 0.8rem;
      padding-right: 4.8rem;
    }

    .showcase-floating-counter {
      right: 0.75rem;
      bottom: 4.75rem;
    }

    .showcase-video-time {
      min-width: 2.1rem;
      font-size: 0.72rem;
    }

    .showcase-video-control-button--muted {
      min-width: 3.2rem;
      font-size: 0.64rem;
    }
  }
</style>