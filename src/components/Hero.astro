---
import PixelSprite from "./PixelSprite.astro";
import { siteConfig } from "../config";
import { spriteIconAssets } from "../utils/iconSprites";
import { getGroupedProjects } from "../utils/portfolio";
import { withBase } from "../utils/url";

type SocialLink = {
  href: string;
  label: string;
  external: boolean;
};

const titleImage = (siteConfig as typeof siteConfig & { title_image?: string }).title_image;
const thanksMessage = (siteConfig as typeof siteConfig & { thanks?: string }).thanks ?? "";
const aboutExcerpt = siteConfig.aboutMe
  .split("。")
  .map((sentence) => sentence.trim())
  .filter(Boolean)
  .slice(0, 2)
  .map((sentence) => `${sentence}。`)
  .join(" ");
const featuredSkills = siteConfig.skills.slice(0, 3);

const socialLinks = [
  siteConfig.social?.email
    ? {
        href: `mailto:${siteConfig.social.email}`,
        label: "Email",
        external: false,
      }
    : null,
  siteConfig.social?.github
    ? {
        href: siteConfig.social.github,
        label: "GitHub",
        external: true,
      }
    : null,
  siteConfig.social?.linkedin
    ? {
        href: siteConfig.social.linkedin,
        label: "LinkedIn",
        external: true,
      }
    : null,
  siteConfig.social?.twitter
    ? {
        href: siteConfig.social.twitter,
        label: "Twitter",
        external: true,
      }
    : null,
].filter((link): link is SocialLink => Boolean(link));

const { games } = await getGroupedProjects();
const primaryAnchor = games.length > 0 ? "#games" : "#other-projects";
---

<section
  id="hero"
  class="relative overflow-hidden border-b border-slate-200/80 bg-white/90 dark:border-slate-800 dark:bg-slate-950"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div
    class="absolute inset-0 opacity-80 dark:opacity-40"
    aria-hidden="true"
    style={`background: radial-gradient(circle at top left, ${siteConfig.accentColor}24 0%, transparent 44%), radial-gradient(circle at bottom right, ${siteConfig.accentColor}12 0%, transparent 32%)`}
  >
  </div>
  <div class="relative mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8 lg:py-18">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.06fr)_minmax(280px,340px)] lg:items-start lg:gap-10">
      <div class="relative flex max-w-3xl flex-col items-start">
        {
          titleImage && (
            <img
              class="w-full max-w-2xl rounded-[2rem] border border-slate-200/80 bg-white/80 object-cover shadow-[0_24px_80px_rgba(15,23,42,0.12)] dark:border-slate-800 dark:bg-slate-900/80"
              src={withBase(titleImage)}
              alt={siteConfig.hero_title}
            />
          )
        }

        <div class="mt-8 max-w-2xl">
          <h1 class="text-balance text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl dark:text-white">
            {siteConfig.hero_title}
          </h1>

          <p class="mt-4 max-w-xl text-base leading-8 text-slate-600 sm:text-lg dark:text-slate-300">
            {thanksMessage}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              class="inline-flex min-h-11 items-center justify-center gap-2.5 rounded-full px-5 text-sm font-semibold text-white shadow-[0_16px_32px_rgba(29,78,216,0.24)] transition-transform hover:-translate-y-0.5"
              href={primaryAnchor}
              style={`background-color: ${siteConfig.accentColor}`}
            >
              <PixelSprite sprite={spriteIconAssets.gameBoy} height={18} />
              View Projects
            </a>
            <a class="inline-flex min-h-11 items-center justify-center gap-2.5 rounded-full border border-slate-300 bg-white/85 px-5 text-sm font-semibold text-slate-900 shadow-sm transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900/75 dark:text-slate-100 dark:hover:bg-slate-800" href={withBase("/about")}>
              <PixelSprite sprite={spriteIconAssets.necoArc} height={18} />
              About Page
            </a>
          </div>
        </div>
      </div>

      <aside class="w-full max-w-sm justify-self-start rounded-[2rem] border border-slate-200/80 bg-white/82 p-6 shadow-[0_24px_70px_rgba(15,23,42,0.10)] backdrop-blur dark:border-slate-800 dark:bg-slate-900/70 sm:p-7 lg:sticky lg:top-24 lg:min-h-[33rem] lg:justify-self-end">
        <div class="flex h-full flex-col">
          <div class="flex items-start gap-4">
            <div class="inline-flex h-20 w-20 items-center justify-center rounded-[1.5rem] border border-slate-200/80 bg-slate-50/85 shadow-inner dark:border-slate-700 dark:bg-slate-800/80">
              <PixelSprite sprite={spriteIconAssets.necoArc} height={56} />
            </div>
            <div>
              <h2 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">
                {siteConfig.name}
              </h2>
              <p class="mt-2 text-sm font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
                {siteConfig.title}
              </p>
            </div>
          </div>

          <p class="mt-6 text-sm leading-7 text-slate-600 dark:text-slate-300">
            {aboutExcerpt}
          </p>

          <div class="mt-6 flex flex-wrap gap-2.5">
            {featuredSkills.map((skill) => (
              <span class="rounded-full border border-slate-200/80 bg-slate-50/90 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-slate-600 dark:border-slate-700 dark:bg-slate-800/80 dark:text-slate-300">
                {skill}
              </span>
            ))}
          </div>

          {
            socialLinks.length > 0 && (
              <div class="mt-8 grid gap-3">
                {socialLinks.map((link) => (
                  <a
                    class="inline-flex items-center justify-between rounded-2xl border border-slate-200/80 bg-white/80 px-4 py-3 text-sm font-medium text-slate-700 transition-colors hover:border-slate-300 hover:text-slate-950 dark:border-slate-700 dark:bg-slate-950/35 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:text-white"
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                  >
                    <span>{link.label}</span>
                    <span class="text-xs uppercase tracking-[0.18em] text-slate-400 dark:text-slate-500">
                      Open
                    </span>
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </aside>
    </div>
  </div>
</section>
