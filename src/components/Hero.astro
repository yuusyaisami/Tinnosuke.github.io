---
import { siteConfig } from "../config";
import { getGroupedProjects } from "../utils/portfolio";
import { withBase } from "../utils/url";

type SocialLink = {
  href: string;
  label: string;
  external: boolean;
};

const titleImage = (siteConfig as typeof siteConfig & { title_image?: string }).title_image;
const thanksMessage = (siteConfig as typeof siteConfig & { thanks?: string }).thanks ?? "";

const socialLinks = [
  siteConfig.social?.email
    ? {
        href: `mailto:${siteConfig.social.email}`,
        label: "Email",
        external: false,
      }
    : null,
  siteConfig.social?.github
    ? {
        href: siteConfig.social.github,
        label: "GitHub",
        external: true,
      }
    : null,
  siteConfig.social?.linkedin
    ? {
        href: siteConfig.social.linkedin,
        label: "LinkedIn",
        external: true,
      }
    : null,
  siteConfig.social?.twitter
    ? {
        href: siteConfig.social.twitter,
        label: "Twitter",
        external: true,
      }
    : null,
].filter((link): link is SocialLink => Boolean(link));

const { games } = await getGroupedProjects();
const primaryAnchor = games.length > 0 ? "#games" : "#other-projects";
---

<section
  id="hero"
  class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-slate-800 dark:bg-slate-950"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div
    class="absolute inset-0 opacity-60 dark:opacity-25"
    aria-hidden="true"
    style={`background: radial-gradient(circle at top left, ${siteConfig.accentColor}20 0%, transparent 42%)`}
  >
  </div>
  <div class="relative mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mx-auto flex max-w-3xl flex-col items-start">
      {
        titleImage && (
          <img
            class="w-full max-w-2xl rounded-3xl border border-slate-200 bg-white/80 object-cover shadow-sm dark:border-slate-800 dark:bg-slate-900/80"
            src={withBase(titleImage)}
            alt={siteConfig.hero_title}
          />
        )
      }

      <div class="mt-8">
        <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
          {siteConfig.hero_title}
        </h1>

        <p class="mt-4 text-base leading-8 text-slate-600 sm:text-lg dark:text-slate-300">
          {thanksMessage}
        </p>

        {
          socialLinks.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-3" aria-label="Social Links">
              {socialLinks.map((link) => (
                <a
                  class="inline-flex items-center rounded-full border border-slate-200 px-4 py-2 text-sm text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-950 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-600 dark:hover:text-white"
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          )
        }

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="inline-flex min-h-11 items-center justify-center rounded-full px-5 text-sm font-semibold text-white shadow-sm"
            href={primaryAnchor}
            style={`background-color: ${siteConfig.accentColor}`}
          >
            View Projects
          </a>
          <a class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-300 bg-white px-5 text-sm font-semibold text-slate-900 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800" href={withBase("/about")}>
            About Page
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
