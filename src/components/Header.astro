---
import PixelSprite from "./PixelSprite.astro";
import RandomSpriteIcon from "./RandomSpriteIcon.astro";
import { siteConfig } from "../config";
import { spriteIconAssets } from "../utils/iconSprites";
import { withBase } from "../utils/url";

const navItems = [
  { href: "/about", label: "About", icon: spriteIconAssets.necoArc },
  { href: "/#games", label: "Games", icon: spriteIconAssets.gameBoy },
  { href: "/#other-projects", label: "Other Projects", icon: spriteIconAssets.hack },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/72 backdrop-blur-xl dark:border-slate-800/80 dark:bg-slate-950/68">
  <div class="mx-auto flex min-h-16 w-full max-w-6xl items-center justify-between gap-6 px-4 py-3 sm:px-6 lg:px-8">
    <a
      class="group flex min-w-0 items-center gap-3 text-slate-900 dark:text-slate-50"
      href={withBase("/")}
      aria-label={siteConfig.name}
    >
      <span class="transition-transform duration-300 group-hover:-translate-y-0.5">
        <RandomSpriteIcon />
      </span>
      <span class="min-w-0">
        <span class="block truncate text-lg font-bold tracking-tight">
          {siteConfig.name}
        </span>
        <span class="hidden text-[11px] font-semibold uppercase tracking-[0.3em] text-slate-500 sm:block dark:text-slate-400">
          {siteConfig.title}
        </span>
      </span>
    </a>

    <nav aria-label="Main Navigation" class="rounded-full border border-slate-200/80 bg-white/80 p-1 shadow-sm dark:border-slate-800 dark:bg-slate-900/72">
      <ul class="flex items-center justify-end gap-1 text-sm font-medium">
        {navItems.map((item) => (
          <li>
            <a
              class="inline-flex min-h-10 items-center gap-2.5 rounded-full px-2.5 py-2 text-slate-600 transition-all duration-200 hover:bg-slate-100 hover:text-slate-950 sm:px-4 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white"
              href={withBase(item.href)}
            >
              <PixelSprite sprite={item.icon} height={18} class="opacity-95" />
              <span class="hidden sm:inline">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
