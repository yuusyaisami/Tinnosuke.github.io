---
import { siteConfig } from "../config";
import { getGroupedProjects } from "../utils/portfolio";

type SocialLink = {
  href: string;
  label: string;
  external: boolean;
};

const socialLinks = [
  siteConfig.social?.email
    ? {
        href: `mailto:${siteConfig.social.email}`,
        label: "Email",
        external: false,
      }
    : null,
  siteConfig.social?.github
    ? {
        href: siteConfig.social.github,
        label: "GitHub",
        external: true,
      }
    : null,
  siteConfig.social?.linkedin
    ? {
        href: siteConfig.social.linkedin,
        label: "LinkedIn",
        external: true,
      }
    : null,
  siteConfig.social?.twitter
    ? {
        href: siteConfig.social.twitter,
        label: "Twitter",
        external: true,
      }
    : null,
].filter((link): link is SocialLink => Boolean(link));

const descriptionSentences = siteConfig.aboutMe
  .split("。")
  .map((sentence) => sentence.trim())
  .filter(Boolean);

const heroDescription = descriptionSentences
  .slice(0, 2)
  .map((sentence) => `${sentence}。`)
  .join(" ");

const skillPreview = siteConfig.skills.slice(0, 3);
const { allProjects, games, otherProjects } = await getGroupedProjects();
const totalItems = allProjects.length;
const latestProject = games[0] ?? allProjects[0];
const primaryAnchor = games.length > 0 ? "#games" : "#other-projects";
const quickFacts = [
  {
    label: "Main Stack",
    value: siteConfig.skills.join(" / "),
  },
  {
    label: "Portfolio",
    value: `${games.length} games / ${otherProjects.length} other projects`,
  },
  {
    label: "Latest",
    value: latestProject
      ? latestProject.data.name
      : `${totalItems} items in portfolio`,
  },
];
---

<section
  id="hero"
  class="relative overflow-hidden border-b border-gray-200 bg-white dark:border-slate-800 dark:bg-slate-950"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div
    class="absolute inset-0 opacity-60 dark:opacity-25"
    aria-hidden="true"
    style={`background: radial-gradient(circle at top left, ${siteConfig.accentColor}20 0%, transparent 42%)`}
  >
  </div>
  <div class="relative mx-auto w-full max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1.45fr)_minmax(280px,360px)] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[var(--accent-color)]">
          {siteConfig.title}
        </p>

        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">
          {siteConfig.name}
        </h1>

        <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600 sm:text-lg dark:text-slate-300">
          {heroDescription || siteConfig.aboutMe}
        </p>

        {
          skillPreview.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {skillPreview.map((skill) => (
                <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                  {skill}
                </span>
              ))}
            </div>
          )
        }

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="inline-flex min-h-11 items-center justify-center rounded-full px-5 text-sm font-semibold text-white shadow-sm"
            href={primaryAnchor}
            style={`background-color: ${siteConfig.accentColor}`}
          >
            View Projects
          </a>
          <a class="inline-flex min-h-11 items-center justify-center rounded-full border border-slate-300 bg-white px-5 text-sm font-semibold text-slate-900 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800" href="/about">
            About Page
          </a>
        </div>

        {
          socialLinks.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-3" aria-label="Social Links">
              {socialLinks.map((link) => (
                <a
                  class="inline-flex items-center rounded-full border border-slate-200 px-4 py-2 text-sm text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-950 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-600 dark:hover:text-white"
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          )
        }
      </div>

      <aside class="rounded-2xl border border-slate-200 bg-white/90 p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900/80">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">
          Quick Info
        </p>

        <dl class="mt-4 space-y-4">
          {quickFacts.map((fact) => (
            <div class="border-b border-slate-200 pb-4 last:border-b-0 last:pb-0 dark:border-slate-800">
              <dt class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
                {fact.label}
              </dt>
              <dd class="mt-2 text-sm leading-7 text-slate-700 dark:text-slate-200">
                {fact.value}
              </dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </div>
</section>
