---
const navItems = [
  { href: "#about", label: "About" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-logo" href="/">
      Tinnosuke's
      <span>Portfolio!</span>
    </a>

    <nav class="site-nav" aria-label="Main Navigation">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(15, 23, 42, 0.82);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .site-header__inner {
    width: min(1120px, calc(100% - 32px));
    height: 72px;
    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-logo {
    color: #e5edf7;
    font-weight: 800;
    font-size: 18px;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .site-logo span {
    margin-left: 8px;
    color: #7d8ca3;
    font-size: 13px;
    font-weight: 600;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 28px;

    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-nav a {
    color: #cbd5e1;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .site-nav a:hover {
    color: #60a5fa;
  }

  @media (max-width: 640px) {
    .site-header__inner {
      height: auto;
      padding: 16px 0;
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .site-nav ul {
      flex-wrap: wrap;
      gap: 14px;
    }
  }
</style>